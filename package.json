{
  "name": "react-native-nitro-xlsx",
  "version": "0.2.5",
  "description": "Fast XLSX file reading and writing for React Native using OpenXLSX and Nitro Modules",
  "license": "MIT",
  "homepage": "https://github.com/zydbkqf/react-native-nitro-xlsx",
  "author": "Denis Cheung (https://github.com/zydbkqf)",
