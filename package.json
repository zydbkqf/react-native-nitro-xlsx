    "jest": "^30.4.2",
    "nitrogen": "*",
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": ">=0.35.8",
    "ts-jest": "^29.4.11",
    "typescript": "5.4.5"
  },
  "files": [
    "src",
    "cpp",
    "!cpp/tests",
    "android",
    "ios",
    "scripts",
    "Package.swift",
    "nitro.json",
    "nitrogen",
    "NitroXlsx.podspec",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "packageManager": "yarn@4.17.1"
